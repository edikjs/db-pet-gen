# Only the topic is provided on the command line. Set the model provider and
# model in .env; change these values here when switching models between runs.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=                     # required for all providers
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=8192
# LLM_MAX_RETRIES=6
# LLM_MAX_CONCURRENCY=1
# RUNS_DIR=artifacts/runs
# OBSERVABILITY_PROVIDER=none      # none | phoenix
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# PHOENIX_PROJECT_NAME=db-pet-gen
