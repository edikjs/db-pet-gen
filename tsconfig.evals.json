{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist-evals",
    "types": ["node"],
    "resolveJsonModule": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "evals/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "dist", "dist-evals"]
}
